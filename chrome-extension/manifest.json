{
  "manifest_version": 3,
  "name": "Availo Fast-Path",
  "version": "1.2.0",
  "description": "Alerts you the instant an earlier DVSA driving-test slot appears and fills your own details so you're one click from booking. Never books, holds, or pays on its own.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://driverpracticaltest.dvsa.gov.uk/*",
    "http://localhost:8000/*",
    "http://localhost:5555/*",
    "http://localhost:4000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://driverpracticaltest.dvsa.gov.uk/*",
        "http://localhost:8000/*",
        "http://localhost:5555/*"
      ],
      "js": [
        "dvsa-heuristics.js",
        "selectors.js",
        "watch-match.js",
        "fastpath-util.js",
        "watch-content.js",
        "fastpath-content.js"
      ]
    }
  ]
}
